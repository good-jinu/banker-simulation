{
  "name": "banker-simulation",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "description": "A simple banking simulation about lending and cash flow.",
  "scripts": {
    "dev": "pnpm --filter @banker-simulation/web dev",
    "build": "pnpm --filter @banker-simulation/web build",
    "typecheck": "pnpm --filter @banker-simulation/web typecheck",
    "format": "prettier --write package.json README.md packages/web/src packages/web/index.html",
    "format:check": "prettier --check package.json README.md packages/web/src packages/web/index.html",
    "check": "pnpm format:check && pnpm --filter @banker-simulation/web check"
  },
  "devDependencies": {
    "prettier": "^3.9.5"
  }
}
